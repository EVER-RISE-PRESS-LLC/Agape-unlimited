{
  "name": "agape-unlimited-foundation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run cf:types && npm run build:social",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "pretypecheck": "npm run cf:types",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:seo": "playwright test tests/seo.spec.ts",
    "deploy": "node scripts/check-deploy.mjs && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare preview",
    "cf:types": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "predev": "node scripts/local-cms.mjs && npm run build:social",
    "build:cloudflare": "opennextjs-cloudflare build",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:seed": "payload run scripts/seed-pages.ts",
    "cms:migration:create": "payload migrate:create",
    "cms:migrate:local": "payload migrate",
    "test:cms": "playwright test --config playwright.cms.config.ts",
    "cms:setup": "node scripts/local-cms.mjs && npm run cms:types && npm run cms:importmap && npm run cms:seed",
    "build:social": "tsx scripts/generate-social-image.tsx"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@payloadcms/db-d1-sqlite": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-r2": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "graphql": "16.11.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.0",
    "typescript": "^5.9.0",
    "wrangler": "4.149.0"
  },
  "type": "module"
}
