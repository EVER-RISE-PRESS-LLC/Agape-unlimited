{
  "name": "agape-unlimited-foundation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "predev": "npm run build:social",
    "prebuild": "npm run cf:types && npm run build:social",
    "build": "next build",
    "start": "wrangler dev --ip 127.0.0.1",
    "lint": "eslint .",
    "pretypecheck": "npm run cf:types",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:seo": "playwright test tests/seo.spec.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview": "wrangler dev --ip 127.0.0.1",
    "cf:types": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "build:social": "tsx scripts/generate-social-image.tsx"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.0",
    "typescript": "^5.9.0",
    "wrangler": "4.149.0"
  },
  "type": "module"
}
